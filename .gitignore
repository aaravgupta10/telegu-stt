# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments & portable Python runtimes
.venv/
venv/
env/
ENV/
demo_live/.venv/
python/
demo_bundle/TeluguTTS_Demo/python/
demo_bundle/TeluguTTS_Demo/TeluguTTS_Demo/

