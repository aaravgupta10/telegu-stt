*.safetensors
*.pt
*.bin
*.pth
*.onnx

# Archive files (unpacked folders are tracked directly)
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# Runtime logs
*.log
*.log.err

# OS files
.DS_Store
Thumbs.db
desktop.ini
